[Unit]
Description=Zhixin Online System API
After=network.target postgresql.service

[Service]
Type=simple
User=zhixin
Group=www-data
WorkingDirectory=/opt/zhixin-online-system/backend
Environment=PATH=/opt/zhixin-online-system/backend/.venv/bin
ExecStart=/opt/zhixin-online-system/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
